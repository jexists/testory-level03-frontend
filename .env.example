# 복사해서 .env.local 로 만든 뒤 값을 채웁니다. (.env.local 은 Git 에 올라가지 않습니다)

# 백엔드(NestJS) 주소. 서버에서만 쓰이며 브라우저에 노출되지 않습니다.
# 로컬: http://localhost:4000 / 운영: Render 서비스 주소 (예: https://testory-backend.onrender.com)
BACKEND_URL=http://localhost:4000

# 로컬 개발 전용 빠른 로그인 버튼이 쓰는 시연 계정 비밀번호 (백엔드 DEMO_PASSWORD 를 바꿨을 때만 적어요)
# NEXT_PUBLIC_DEMO_PASSWORD=
